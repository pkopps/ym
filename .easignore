# --- EAS Build only (.easignore replaces .gitignore for EAS uploads) ---
# Mobile builds need the root workspace manifests, packages/, and apps/*
# package.json files. Agent, report, and design artifacts are not used.
.claude/
.codex/
.agents/
.projects/
docs/
reports/
output/
outputs/
zocdoc-screenshots/
test-results/
tests/
apps/experience-map/public/captures/
apps/web/public/

# Nested .gitignore files are not applied when .easignore exists; mirror
# apps/*/ios/.gitignore so local CocoaPods and Xcode output stay local.
**/ios/Pods/
**/ios/build/
**/ios/.xcode.env.local
xcuserdata
DerivedData
*.xcuserstate
*.ipa
*.jsbundle
