{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@yardmatch/branding": [
        "packages/branding/src"
      ],
      "@yardmatch/contracts": [
        "packages/contracts/src"
      ],
      "@yardmatch/domain": [
        "packages/domain/src"
      ],
      "@yardmatch/analytics": [
        "packages/analytics/src"
      ],
      "@yardmatch/help-center": [
        "packages/help-center/src"
      ],
      "@yardmatch/observability": [
        "packages/observability/src"
      ],
      "@yardmatch/ui": [
        "packages/ui/src"
      ]
    }
  }
}
