import fs from "node:fs";
import { chromium, expect } from "@playwright/test";

const base = process.env.EXPERIENCE_MAP_URL ?? "http://127.0.0.1:4173";
const evidence = "reports/agent-checkpoints/engineer/latest";
const inventory = JSON.parse(fs.readFileSync("apps/experience-map/data/inventory.json", "utf8"));
const screenCount = inventory.nodes.length;
const opsCount = inventory.nodes.filter((node: { role: string }) => node.role === "ops").length;
fs.mkdirSync(evidence, { recursive: true });
const browser = await chromium.launch({ headless: true });
try {
  const page = await browser.newPage({ viewport: { width: 1440, height: 900 }, deviceScaleFactor: 1 });
  await page.goto(base);
  await expect(page.getByRole("heading", { name: "Experience map" })).toBeVisible();
  await expect(page.locator(".screen-card")).toHaveCount(screenCount, { timeout: 20000 });
  await expect(page.locator(".card-image img").first()).toBeVisible();
  const loaded = await page.locator(".card-image img").first().evaluate((image: HTMLImageElement) => image.complete && image.naturalWidth > 0);
  if (!loaded) throw new Error("Screenshot card image did not load.");
  await page.waitForTimeout(2500);
  await page.screenshot({ path: `${evidence}/experience-map-desktop.png` });
  await page.getByRole("searchbox", { name: "Find a screen or path" }).fill("web:/customer/dashboard");
  await expect(page.locator(".screen-card")).toHaveCount(1);
  await page.locator(".card-text").click();
  await expect(page.getByRole("heading", { name: "Next actions" })).toBeVisible();
  await page.getByRole("button", { name: /Open screenshot/ }).click();
  await expect(page.getByRole("dialog")).toBeVisible();
  await expect(page.getByRole("dialog").locator("img")).toBeVisible();
  await page.getByRole("button", { name: "Close screenshot" }).click();
  await page.getByRole("searchbox", { name: "Find a screen or path" }).fill("");
  await page.getByRole("button", { name: "ops", exact: true }).click();
  await expect(page.locator(".screen-card")).toHaveCount(screenCount - opsCount);
  await page.getByRole("button", { name: "ops", exact: true }).click();
  await page.getByRole("button", { name: "Collapse provider section" }).click();
  await expect(page.getByText("Provider paths")).toBeVisible();
  await page.getByRole("button", { name: "Expand provider section" }).click();
  await expect(page.locator(".screen-card")).toHaveCount(screenCount);
  await page.getByRole("combobox").selectOption("test-verified");
  await expect(page.locator(".react-flow__edge").first()).toBeVisible();
  await page.getByRole("combobox").selectOption("all");
  await page.locator('.react-flow__node[data-id="web:/"] .card-text').click();
  await expect(page.locator(".edge-highlight").first()).toBeVisible();
  await page.getByRole("button", { name: "Close details" }).click();
  await page.setViewportSize({ width: 390, height: 844 });
  await page.reload();
  await expect(page.getByRole("heading", { name: "Experience map" })).toBeVisible();
  await page.waitForTimeout(2500);
  await page.screenshot({ path: `${evidence}/experience-map-mobile.png` });
  const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);
  if (overflow > 1) throw new Error(`Mobile horizontal overflow: ${overflow}px`);
  console.log("Viewer checks passed: cards, screenshots, search, role filter, section collapse, evidence filter, path highlighting, details, modal, responsive layout.");
} finally { await browser.close(); }
