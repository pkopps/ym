# Shared API
YARDMATCH_ENV=local
API_BASE_URL=http://localhost:4001
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
EXPO_PUBLIC_API_BASE_URL=http://localhost:4001
EXPO_PUBLIC_YARDMATCH_ENV=local
EXPO_PUBLIC_EXPO_PROJECT_ID=
DATABASE_URL=postgresql://yardmatch:yardmatch@localhost:5432/yardmatch
JWT_SECRET=change-me-in-local-dev
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public token for Search Console URL-prefix verification (not an OAuth credential).
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_DEFAULT_SERVICE_AREA_LABEL=Barnegat, NJ
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_MAX_REQUEST_BODY_BYTES=2500000

# Evidence photos (inline is local/test only; staging and production require private Blob)
PHOTO_STORAGE_MODE=inline
BLOB_READ_WRITE_TOKEN=

# Social auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Address and map UX
GOOGLE_MAPS_API_KEY=
GOOGLE_ADDRESS_VALIDATION_API_KEY=

# Notifications
EXPO_PUBLIC_EXPO_PROJECT_ID=
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
INBOUND_LEAD_WEBHOOK_SECRET=
INBOUND_REVIEW_RESPONSE_WEBHOOK_SECRET=
OPS_EXPECTED_INBOUND_AUTOMATION_SOURCES=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFICATION_ALERT_EMAILS=
NOTIFICATION_ALERT_SMS_NUMBERS=
STAGING_NOTIFICATION_ALLOWED_EMAILS=
STAGING_NOTIFICATION_ALLOWED_SMS_NUMBERS=
STAGING_NOTIFICATION_ALLOWED_PUSH_TOKENS=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional dedicated Checkout configuration with cards, eligible wallets, and US bank account enabled.
STRIPE_CHECKOUT_PAYMENT_METHOD_CONFIGURATION=

# Required only when loading fixtures into staging; never use the local default
YARDMATCH_STAGING_SEED_PASSWORD=

# Future quote engine inputs
LICENSED_IMAGERY_PROVIDER=
PROPERTY_ESTIMATE_MODEL_ID=

# OpenTelemetry / OTLP
OTEL_SERVICE_NAME=yardmatch-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# API reliability monitoring (bounded in-process summary plus structured logs)
API_SLOW_REQUEST_THRESHOLD_MS=1500
API_RECENT_FAILURE_LIMIT=100
ANALYTICS_MAX_IN_MEMORY_EVENTS=10000

# Optional product analytics: PostgreSQL is the durable source of truth.
# PostHog export only runs in production; leave unset until project/region approval.
POSTHOG_API_KEY=
POSTHOG_HOST=
ANALYTICS_IDENTITY_HASH_KEY=
ANALYTICS_RETENTION_DAYS=90
# Dedicated active ops identity for the scheduler. Keep disabled until a dry run is reviewed.
OPS_AUTOMATION_USER_ID=
OPS_AUTOMATION_TOKEN=
OPS_AUTOMATION_ENABLED=0
MINIMUM_CUSTOMER_MOBILE_VERSION=0.1.0
MINIMUM_PROVIDER_MOBILE_VERSION=0.1.0
MINIMUM_CREW_MOBILE_VERSION=0.1.0
PAUSE_CUSTOMER_MOBILE=0
PAUSE_PROVIDER_MOBILE=0
PAUSE_CREW_MOBILE=0
# Comma-separated internal/test account IDs excluded from product reports and export.
ANALYTICS_EXCLUDED_USER_IDS=
# Owner-approved review age only; the inventory script never deletes photos.
PHOTO_RETENTION_REVIEW_DAYS=
