{
  "name": "yardmatch-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "next dev apps/web",
    "dev:experience-map": "npm --workspace @yardmatch/experience-map run dev",
    "experience-map:refresh": "node scripts/experience-map/refresh.mjs",
    "experience-map:validate": "node scripts/experience-map/validate.mjs",
    "dev:customer-mobile": "npm --workspace @yardmatch/customer-mobile run dev",
    "dev:provider-mobile": "npm --workspace @yardmatch/provider-mobile run dev",
    "dev:crew-mobile": "npm --workspace @yardmatch/crew-mobile run dev",
    "dev:api": "PORT=${PORT:-4001} node --import tsx apps/api/src/index.ts",
    "start:api": "node --import tsx apps/api/src/index.ts",
    "build:web": "next build apps/web",
    "build:experience-map": "npm --workspace @yardmatch/experience-map run build",
    "build:customer-mobile": "npm --workspace @yardmatch/customer-mobile run export",
    "build:provider-mobile": "npm --workspace @yardmatch/provider-mobile run export",
    "build:crew-mobile": "npm --workspace @yardmatch/crew-mobile run export",
    "build:mobile": "npm run build:customer-mobile && npm run build:provider-mobile && npm run build:crew-mobile",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "prisma:generate": "npm --workspace @yardmatch/api run prisma:generate",
    "prisma:migrate": "npm --workspace @yardmatch/api run prisma:migrate",
    "prisma:deploy": "npm --workspace @yardmatch/api run prisma:deploy",
    "prisma:seed": "npm --workspace @yardmatch/api run prisma:seed",
    "test:api": "npm --workspace @yardmatch/api run test",
    "test:scale": "node --import tsx scripts/scale-smoke.mts",
    "test:api:postgres": "npm --workspace @yardmatch/api run test:postgres",
    "test:api:smoke": "node scripts/api-smoke.mjs",
    "test:web:smoke": "playwright test --config=playwright.config.ts",
    "test:staging:api": "YARDMATCH_SMOKE_START_API=0 npm run test:api:smoke",
    "test:staging:wait": "node scripts/wait-for-staging.mjs",
    "test:staging:photos": "node scripts/staging-photo-smoke.mjs",
    "test:staging:web": "playwright test --config=playwright.staging.config.ts",
    "test:staging:acceptance": "npm run test:staging:wait && npm run test:staging:api && npm run test:staging:photos && npm run test:staging:web",
    "test:smoke": "npm run test:api:smoke && npm run test:web:smoke",
    "verify:production-config": "npm --workspace @yardmatch/api run verify:production-config",
    "verify:mobile-release": "node scripts/verify-mobile-release-config.mjs",
    "i18n:validate": "npm --workspace @yardmatch/i18n run validate",
    "i18n:export:tms": "npm --workspace @yardmatch/i18n run export:tms",
    "i18n:audit:literals": "npm --workspace @yardmatch/i18n run audit:literals",
    "verify": "npm run prisma:generate && npm run lint && npm run typecheck && npm run verify:mobile-release && npm run test:api",
    "verify:local": "npm run verify && npm run test:smoke",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:prune-suppressions": "eslint . --prune-suppressions",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "prisma": "^6.19.3",
    "react-native": "0.83.10",
    "tsx": "4.23.6",
    "turbo": "^2.10.8",
    "typescript": "*",
    "typescript-eslint": "8.66.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
