generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAccount {
  id                             String                   @id
  email                          String                   @unique
  passwordHash                   String?
  googleSubject                  String?                  @unique
  appleSubject                   String?                  @unique
  sessionVersion                 Int                      @default(1)
  internalScope                  String?
  accessDisabledAt               DateTime?
  accessDisabledBy               String?
  accessChangeNotes              String?
  lastAccessChangeAt             DateTime?
  lastAccessChangeBy             String?
  lastAccessChangeKind           String?
  accessChangeHistory            Json?
  authenticationEventHistory     Json?
  lastAuthenticatedAt            DateTime?
  lastAuthenticatedMethod        String?
  failedAuthenticationCount      Int                      @default(0)
  lastFailedAuthenticationAt     DateTime?
  lastFailedAuthenticationReason String?
  authenticationLockExpiresAt    DateTime?
  resetPasswordCodeHash          String?
  resetPasswordExpiresAt         DateTime?
  resetPasswordRequestedAt       DateTime?
  twoFactorMethod                String?
  twoFactorEnabledAt             DateTime?
  twoFactorChallengeId           String?
  twoFactorChallengePurpose      String?
  twoFactorChallengeMethod       String?
  twoFactorChallengeCodeHash     String?
  twoFactorChallengeExpiresAt    DateTime?
  twoFactorChallengeRequestedAt  DateTime?
  twoFactorChallengeFailedAttempts Int                      @default(0)
  twoFactorChallengeDeviceIdHash String?
  twoFactorChallengeDeviceLabel  String?
  twoFactorChallengeDevicePlatform String?
  trustedDevices                 Json?
  securityEventHistory           Json?
  fullName                       String
  phone                          String
  role                           String
  address                        Json
  createdAt                      DateTime                 @default(now())
  customer                       CustomerProfile?
  provider                       ProviderBusinessProfile?
  crewMember                     CrewMemberProfile?

  @@map("user_accounts")
}

model CustomerProfile {
  userId                String                         @id
  propertyNotes         String
  lawnSizeSqFt          Int
  defaultPropertyId     String?
  user                  UserAccount                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties            CustomerProperty[]
  providerRelationships CustomerProviderRelationship[]
  referrals             CustomerReferral[]

  @@map("customer_profiles")
}

model CustomerProperty {
  id               String          @id
  customerId       String
  label            String
  address          Json
  gateCode         String?
  accessNotes      String?
  lawnSizeSqFt     Int?
  shrubBedSqFt     Int?
  drivewaySqFt     Int?
  sidewalkLinearFt Int?
  isDefault        Boolean         @default(false)
  createdAt        DateTime
  customer         CustomerProfile @relation(fields: [customerId], references: [userId], onDelete: Cascade)

  @@map("customer_properties")
}

model ProviderBusinessProfile {
  servicePrices                Json                           @default("[]")
  userId                       String                         @id
  companyName                  String
  bio                          String
  yearsExperience              Int
  serviceRadiusMiles           Int
  minimumBookingLeadHours      Int                            @default(0)
  staffingMode                 String                         @default("review-first")
  crewReviewLeadHours          Int                            @default(24)
  departureReminderLeadMinutes Int                            @default(60)
  routeLeaderMode              String                         @default("provider-only")
  weeklyPayoutDay              String                         @default("Thu")
  instantPayoutsEnabled        Boolean                        @default(false)
  verificationStatus           String                         @default("pending-review")
  verificationSubmittedAt      DateTime?
  verificationReviewedAt       DateTime?
  verificationNotes            String?
  sponsoredListingEnabled      Boolean                        @default(false)
  categories                   String[]
  rating                       Float
  timelinessRating             Float
  attentionToDetailRating      Float
  reviewCount                  Int
  calendarConnection           Json
  user                         UserAccount                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots                        AvailabilitySlot[]
  credentials                  ProviderCredential[]
  connectAccount               ProviderConnectAccount?
  customerRelationships        CustomerProviderRelationship[]

  @@index([verificationStatus, userId])
  @@index([categories], type: Gin)
  @@map("provider_business_profiles")
}

model CrewMemberProfile {
  userId               String      @id
  bio                  String
  yearsExperience      Int
  categories           String[]
  availableWeekdays    String[]
  willingToTravelMiles Int
  preferredSchedule    String
  hasOwnEquipment      Boolean
  winterWorkEnabled    Boolean     @default(false)
  rating               Float
  completedJobs        Int
  cancellationCount    Int         @default(0)
  lastCancellationAt   DateTime?
  status               String
  assignedProviderId   String?
  user                 UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crew_member_profiles")
}

model AvailabilitySlot {
  id         String                  @id
  providerId String
  startIso   DateTime
  endIso     DateTime
  isBooked   Boolean                 @default(false)
  provider   ProviderBusinessProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@index([providerId, isBooked, startIso, id])
  @@map("availability_slots")
}

model Booking {
  id                              String                      @id
  customerId                      String
  providerId                      String
  launchLeadId                    String?
  recurringPlanId                 String?
  recurringOccurrenceIndex        Int?
  serviceAddress                  Json
  servicePropertyId               String?
  category                        String
  services                        Json                        @default("[]")
  requestedAt                     DateTime
  scheduledStartIso               DateTime
  scheduledEndIso                 DateTime
  status                          String
  assignedRouteLeaderCrewMemberId String?
  onRouteConfirmedAt              DateTime?
  onRouteConfirmedByCrewMemberId  String?
  lateNoticeSentAt                DateTime?
  lateEtaIso                      DateTime?
  lateReason                      String?
  recovery                        Json?
  scheduleUpdates                 Json                        @default("[]")
  scheduleVersion                 Int                         @default(0)
  activeExceptionType             String?
  activeExceptionReportedAt       DateTime?
  activeExceptionNotes            String?
  routeActiveStop                 Json?
  routeLivePoint                  Json?
  routeLiveUpdatedAt              DateTime?
  routeLiveSource                 String?
  routeLiveSpeedMph               Float?
  routeLiveAccuracyMeters         Float?
  disputedAt                      DateTime?
  disputeReason                   String?
  disputedByRole                  String?
  completedAt                     DateTime?
  notes                           String
  totalCents                      Int
  reviewId                        String?
  serviceEvidence                 Json
  interventions                   Json
  addressChangeHistory            Json
  financialSettlement             BookingFinancialSettlement?

  @@index([customerId, scheduledStartIso, id])
  @@index([providerId, scheduledStartIso, id])
  @@map("bookings")
}

model RecurringServicePlan {
  id                      String    @id
  customerId              String
  providerId              String
  launchLeadId            String?
  serviceAddress          Json
  servicePropertyId       String?
  category                String
  frequency               String
  requestedAt             DateTime
  notes                   String
  totalCents              Int
  status                  String
  anchorScheduledStartIso DateTime
  anchorScheduledEndIso   DateTime
  lastGeneratedBookingId  String?
  lastGeneratedAt         DateTime?
  lastSchedulingAttemptAt DateTime?
  lastSchedulingError     String?
  cancelledAt             DateTime?
  cancellationReason      String?

  @@index([providerId, status])
  @@map("recurring_service_plans")
}

model CrewMatch {
  id                   String    @id
  bookingId            String
  providerId           String
  crewMemberId         String
  crewMemberName       String
  crewMemberPhone      String
  categories           String[]
  availableWeekdays    String[]
  preferredSchedule    String
  willingToTravelMiles Int
  hasOwnEquipment      Boolean
  winterWorkEnabled    Boolean
  status               String
  autoAccepted         Boolean   @default(false)
  distanceMiles        Float
  hourlyRateCents      Int
  cancellationReason   String?
  cancelledAt          DateTime?
  createdAt            DateTime
  reviewedAt           DateTime?

  @@unique([bookingId, crewMemberId])
  @@map("crew_matches")
}

model ProviderCrewConversation {
  id                 String   @id
  crewMatchId        String   @unique
  bookingId          String
  providerId         String
  crewMemberId       String
  providerName       String
  crewMemberName     String
  status             String
  updatedAt          DateTime
  lastMessagePreview String?
  unreadCount        Int      @default(0)
  createdAt          DateTime

  @@map("provider_crew_conversations")
}

model ProviderCrewMessage {
  id             String   @id
  conversationId String
  senderId       String
  senderRole     String
  body           String
  createdAt      DateTime

  @@index([conversationId, createdAt, id])
  @@map("provider_crew_messages")
}

model CustomerProviderConversation {
  id                 String   @id
  bookingId          String   @unique
  customerId         String
  providerId         String
  customerName       String
  providerName       String
  updatedAt          DateTime
  lastMessagePreview String?
  unreadCount        Int      @default(0)
  createdAt          DateTime

  @@map("customer_provider_conversations")
}

model CustomerProviderMessage {
  id             String   @id
  conversationId String
  senderId       String
  senderRole     String
  body           String
  createdAt      DateTime

  @@index([conversationId, createdAt, id])
  @@map("customer_provider_messages")
}

model ProviderReview {
  id                      String    @id
  bookingId               String    @unique
  providerId              String
  customerId              String
  overallRating           Int
  timelinessRating        Int
  attentionToDetailRating Int
  reviewText              String
  responseStatus          String
  responseHandledAt       DateTime?
  responseHandledBy       String?
  responseNotes           String?
  publicReplyBody         String?
  responseChannel         String?
  responseChannelMetadata Json?
  externalResponseId      String?
  publicResponseUrl       String?
  supportTicketId         String?
  escalatedAt             DateTime?
  escalatedBy             String?
  escalationNotes         String?
  createdAt               DateTime

  @@map("provider_reviews")
}

model ReviewInvite {
  id               String    @id
  bookingId        String    @unique
  customerId       String
  providerId       String
  email            String
  status           String
  channels         String[]
  scheduledSendIso DateTime
  sentAt           DateTime?
  openedAt         DateTime?
  completedAt      DateTime?
  expiresAtIso     DateTime
  deepLinkPath     String

  @@map("review_invites")
}

model SecurityState {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
  @@map("security_states")
}

model PaymentRecord {
  fullRefundAttempt       Json?
  partialRefunds           Json @default("[]")
  refundedAmountCents      Int @default(0)
  checkoutSessionExpiredAt DateTime?
  checkoutSuccessPath      String?
  checkoutCancelPath       String?
  id                       String                      @id
  bookingId                String
  amountCents              Int
  currency                 String
  status                   String
  processor                String
  refundable               Boolean
  checkoutSessionId        String?
  checkoutSessionUrl       String?
  processorPaymentIntentId String?
  processorChargeId        String?
  actualProcessorFeeCents  Int?
  processorFeeStatus       String?
  processorFeeUpdatedAt    DateTime?
  processorFeeFailureReason String?
  refundReason             String?
  refundReviewStatus       String?
  refundRequestedAt        DateTime?
  refundRequestedByRole    String?
  refundReviewedAt         DateTime?
  refundReviewedByRole     String?
  refundDecisionNotes      String?
  failureReason            String?
  paidAt                   DateTime?
  createdAt                DateTime
  updatedAt                DateTime
  financialSettlement      BookingFinancialSettlement?

  @@unique([checkoutSessionId])
  @@unique([processorPaymentIntentId])
  @@unique([processorChargeId])
  @@index([bookingId, updatedAt, id])
  @@map("payment_records")
}

model PayoutDisbursementRun {
  id                      String    @id
  previewBatchId          String
  entryFingerprint        String
  runDateIso              DateTime
  recipientRole           String
  railMode                String
  actionStatus            String
  status                  String
  totalCents              Int
  recipientCount          Int
  bookingCount            Int
  entryCount              Int
  recipientIds            String[]
  entryIds                String[]
  entries                 Json
  blockerReasons          String[]
  manualActionLabel       String
  auditInstructions       String[]
  createdAt               DateTime
  updatedAt               DateTime
  createdByOpsUserId      String
  createdByOpsEmail       String
  operatorNotes           String?
  reconciliationReference String?
  reconciliationNotes     String?
  reconciledAt            DateTime?
  reconciledByOpsUserId   String?

  @@unique([previewBatchId, entryFingerprint])
  @@map("payout_disbursement_runs")
}

model ProviderCredential {
  id                  String                  @id
  providerId          String
  type                String
  status              String
  jurisdiction        String
  referenceNumber     String?
  documentUrl         String?
  issuedAt            DateTime?
  expiresAt           DateTime?
  submittedAt         DateTime
  reviewedAt          DateTime?
  reviewedByOpsUserId String?
  reviewNotes         String?
  provider            ProviderBusinessProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@unique([providerId, type, jurisdiction])
  @@index([status, expiresAt])
  @@map("provider_credentials")
}

model ProviderConnectAccount {
  providerId       String                  @id
  stripeAccountId  String                  @unique
  dashboard        String
  feesCollector    String
  lossesCollector  String
  chargePattern    String
  onboardingStatus String
  transfersStatus  String
  payoutsStatus    String
  createdAt        DateTime
  updatedAt        DateTime
  lastSyncedAt     DateTime?
  provider         ProviderBusinessProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@index([onboardingStatus, transfersStatus])
  @@map("provider_connect_accounts")
}

model CustomerProviderRelationship {
  customerId            String
  providerId            String
  firstSettledBookingId String                  @unique
  createdAt             DateTime
  customer              CustomerProfile         @relation(fields: [customerId], references: [userId], onDelete: Restrict)
  provider              ProviderBusinessProfile @relation(fields: [providerId], references: [userId], onDelete: Restrict)

  @@id([customerId, providerId])
  @@map("customer_provider_relationships")
}

model BookingFinancialSettlement {
  id                                  String                 @id
  bookingId                           String                 @unique
  paymentId                           String                 @unique
  customerId                          String
  providerId                          String
  policyVersion                       String
  currency                            String
  customerChargeCents                 Int
  providerServiceGrossCents           Int
  finderFeeCents                      Int
  completedJobFeeCents                Int
  platformGrossRevenueCents           Int
  actualProcessorFeeCents             Int
  platformNetRevenueCents             Int
  providerNetCents                    Int
  crewPayoutByYardMatchCents          Int                    @default(0)
  isFirstCompletedCustomerProviderJob Boolean
  status                              String
  createdAt                           DateTime
  updatedAt                           DateTime
  booking                             Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment                             PaymentRecord          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ledgerEntries                       FinancialLedgerEntry[]
  providerTransfer                    ProviderTransferRecord?

  @@index([providerId, status, createdAt])
  @@index([customerId, providerId])
  @@map("booking_financial_settlements")
}

model ProviderTransferRecord {
  id                       String                     @id
  settlementId             String                     @unique
  bookingId                String                     @unique
  paymentId                String
  providerId               String
  stripeAccountId          String
  stripeTransferId         String?                    @unique
  stripeTransferReversalId String?                    @unique
  amountCents              Int
  currency                 String
  status                   String
  idempotencyKey           String                     @unique
  failureReason            String?
  createdAt                DateTime
  updatedAt                DateTime
  transferredAt            DateTime?
  reversedAt               DateTime?
  settlement               BookingFinancialSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([providerId, status, createdAt])
  @@index([paymentId])
  @@map("provider_transfer_records")
}

model FinancialLedgerEntry {
  id                String                     @id
  settlementId      String
  bookingId         String
  paymentId         String
  account           String
  direction         String
  amountCents       Int
  currency          String
  idempotencyKey    String                     @unique
  source            String
  reversalOfEntryId String?
  createdAt         DateTime
  settlement        BookingFinancialSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([account, createdAt])
  @@map("financial_ledger_entries")
}

model LaunchOperationsTask {
  id                        String    @id
  recommendationFingerprint String    @unique
  recommendationKey         String
  pocketKey                 String
  city                      String
  state                     String
  postalCode                String
  priority                  String
  owner                     String
  status                    String
  title                     String
  detail                    String
  recommendedAction         String
  dueAtIso                  DateTime
  relatedScenarioKeys       String[]
  createdAt                 DateTime
  updatedAt                 DateTime
  createdByOpsUserId        String
  createdByOpsEmail         String
  assignedToOpsUserId       String?
  assignedToOpsEmail        String?
  operatorNotes             String?
  completionNotes           String?
  completedAt               DateTime?
  completedByOpsUserId      String?

  @@index([status, priority])
  @@index([pocketKey, recommendationKey])
  @@map("launch_operations_tasks")
}

model OpsAutomationRun {
  id                    String   @id
  runId                 String   @unique
  generatedAt           DateTime
  asOfIso               DateTime
  dryRun                Boolean
  requestedSweepKeys    String[]
  requestedSweepCount   Int
  completedSweepCount   Int
  failedSweepCount      Int
  sentNotificationCount Int
  alreadySentCount      Int
  skippedCount          Int
  items                 Json
  createdAt             DateTime
  createdByOpsUserId    String
  createdByOpsEmail     String

  @@index([createdAt])
  @@index([dryRun, createdAt])
  @@map("ops_automation_runs")
}

model SupportTicket {
  complaint        Json?
  id               String    @id
  bookingId        String?
  launchLeadId     String?
  requesterId      String
  subject          String
  description      String
  issueType        String
  status           String
  createdAt        DateTime
  updatedAt        DateTime
  triagedAt        DateTime?
  resolvedAt       DateTime?
  resolutionNotes  String?
  resolutionAction String?

  @@index([bookingId])
  @@map("support_tickets")
}

model LaunchLead {
  id                      String    @id
  sourceChannel           String
  requestSource           String?
  sourceReferenceId       String?   @unique
  channelMetadata         Json?
  attribution             Json?
  contactName             String
  email                   String?
  phone                   String?
  preferredContactMethod  String
  areaLabel               String
  serviceCategory         String?
  message                 String
  status                  String
  assignedOwner           String?
  firstResponseDueAt      DateTime
  firstRespondedAt        DateTime?
  lastContactedAt         DateTime?
  nextFollowUpDueAt       DateTime?
  closedAt                DateTime?
  lossReason              String?
  outcomeSummary          String?
  convertedBookingIds     String[]
  reviewIds               String[]
  firstConvertedBookingAt DateTime?
  lastConvertedBookingAt  DateTime?
  lastReviewSubmittedAt   DateTime?
  createdAt               DateTime
  updatedAt               DateTime
  customerReferral        CustomerReferral?

  @@index([status, createdAt])
  @@index([assignedOwner, status])
  @@map("launch_leads")
}

model CustomerReferral {
  id                 String          @id
  referrerCustomerId String
  leadId             String          @unique
  friendName         String
  channel            String
  contact            String
  areaLabel          String?
  consentVersion     String
  consentedAt        DateTime
  createdAt          DateTime
  referrer           CustomerProfile @relation(fields: [referrerCustomerId], references: [userId], onDelete: Cascade)
  lead               LaunchLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([referrerCustomerId, channel, contact])
  @@index([referrerCustomerId, createdAt])
  @@map("customer_referrals")
}

model AppNotification {
  id            String    @id
  recipientId   String
  recipientRole String
  category      String
  title         String
  body          String
  actionHref    String?
  isRead        Boolean   @default(false)
  createdAt     DateTime
  readAt        DateTime?

  @@index([recipientId, createdAt])
  @@map("app_notifications")
}

model NotificationPreference {
  userId                 String   @id
  role                   String
  emailEnabled           Boolean  @default(true)
  smsEnabled             Boolean  @default(true)
  pushEnabled            Boolean  @default(true)
  reviewRemindersEnabled Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime

  @@map("notification_preferences")
}

model NotificationDelivery {
  id             String    @id
  notificationId String
  recipientId    String
  recipientRole  String
  category       String
  channel        String
  destination    String
  provider       String
  status         String
  title          String
  bodyPreview    String
  errorMessage   String?
  attemptCount   Int       @default(0)
  createdAt      DateTime
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  sentAt         DateTime?
  leaseToken     String?
  leaseExpiresAt DateTime?

  @@index([recipientId, createdAt])
  @@index([notificationId])
  @@index([status, nextRetryAt, leaseExpiresAt, createdAt, id], map: "notification_delivery_due_idx")
  @@map("notification_deliveries")
}

model PushDevice {
  id         String   @id
  userId     String
  role       String
  platform   String
  provider   String
  token      String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  lastSeenAt DateTime

  @@index([userId, role, isActive])
  @@map("push_devices")
}

model ProductAnalyticsEvent {
  id          String   @id
  name        String
  actorId     String?
  occurredAt  DateTime
  receivedAt  DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)"))
  environment String
  source      String
  properties  Json
  exportedAt  DateTime?
  attempts    Int      @default(0)
  nextAttemptAt DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)"))
  exportLeaseToken String?
  exportLeaseExpiresAt DateTime?

  @@index([environment, occurredAt])
  @@index([actorId, occurredAt])
  @@index([exportedAt, nextAttemptAt])
  @@index([environment, exportedAt, nextAttemptAt, exportLeaseExpiresAt], map: "analytics_export_due_idx")
  @@index([environment, receivedAt])
}

model PrivacyRequest {
  id            String   @id
  userId        String
  kind          String
  status        String   @default("requested")
  requestedAt   DateTime @default(now())
  updatedAt     DateTime @default(now())
  reviewedBy    String?
  reviewNotes   String?
  audit         Json     @default("[]")
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

model ZipServiceMinimum {
  postalCode                 String
  category                   String
  minimumStartingPriceCents  Int
  history                    Json @default("[]")

  @@id([postalCode, category])
  @@map("zip_service_minimums")
}
