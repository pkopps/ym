{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_YARDMATCH_ENV": "local",
        "YARDMATCH_APS_ENVIRONMENT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_YARDMATCH_ENV": "staging",
        "YARDMATCH_APS_ENVIRONMENT": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "store-test": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_YARDMATCH_ENV": "staging",
        "YARDMATCH_APS_ENVIRONMENT": "production"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_YARDMATCH_ENV": "production",
        "YARDMATCH_APS_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "store-test": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {}
  }
}
