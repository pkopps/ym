{
  "name": "@yardmatch/customer-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "expo start",
    "dev:client": "expo start --dev-client",
    "dev:client:personal": "EXPO_PUBLIC_DISABLE_PUSH_FOR_LOCAL_DEVICE=1 expo start --dev-client",
    "export": "expo export",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:device:personal": "YARDMATCH_DISABLE_PUSH_FOR_LOCAL_DEVICE=1 EXPO_PUBLIC_DISABLE_PUSH_FOR_LOCAL_DEVICE=1 expo run:ios --device",
    "android": "expo run:android",
    "android:device": "expo run:android --device"
  },
  "dependencies": {
    "@yardmatch/branding": "0.1.0",
    "@yardmatch/contracts": "0.1.0",
    "@yardmatch/help-center": "0.1.0",
    "@yardmatch/observability": "0.1.0",
    "@yardmatch/ui": "0.1.0",
    "expo": "~55.0.23",
    "expo-dev-client": "~55.0.35",
    "expo-local-authentication": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-secure-store": "~55.0.14",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6"
  }
}
