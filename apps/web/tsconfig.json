{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "composite": true,
    "outDir": "dist"
  },
  "references": [
    {
      "path": "../../packages/branding"
    },
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/help-center"
    },
    {
      "path": "../../packages/observability"
    },
    {
      "path": "../../packages/ui"
    }
  ],
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
