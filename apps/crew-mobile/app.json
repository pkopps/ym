{
  "expo": {
    "name": "YardMatch Crew",
    "slug": "yardmatch-crew",
    "scheme": "yardmatch-crew",
    "version": "0.1.0",
    "orientation": "default",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-dev-client",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "YardMatch uses Face ID so you can quickly reopen the crew app on this device."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yardmatch.crew",
      "infoPlist": {
        "NSFaceIDUsageDescription": "YardMatch uses Face ID so you can quickly reopen the crew app on this device."
      }
    },
    "android": {
      "package": "com.yardmatch.crew"
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
