{
  "expo": {
    "name": "YardMatch Crew",
    "slug": "yardmatch-crew",
    "scheme": "yardmatch-crew",
    "version": "0.1.0",
    "orientation": "default",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "YardMatch uses Face ID so you can quickly reopen the crew app on this device."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ]
  }
}
